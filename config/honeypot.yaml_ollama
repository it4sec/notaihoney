version: 1

# ---------------------------------------------------------------------------
# GLOBAL SETTINGS
# ---------------------------------------------------------------------------

global:
  tls:
    directory: "/etc/notaihoney/tls"

sensor:
  id: "sensor-01"

# ---------------------------------------------------------------------------
# EVIDENCE
# PCAPNG, BWJ and JSONL are mandatory Milestone 1 evidence subsystems.
# They intentionally have no enabled switches.
# ---------------------------------------------------------------------------

evidence:
  min_free_bytes: 5368709120

  pcap:
    interface: "eth0"
    directory: "/var/lib/notaihoney/pcap"
    rotate_size_bytes: 268435456
    rotate_seconds: 3600

  wire_journal:
    directory: "/var/lib/notaihoney/journal"
    rotate_size_bytes: 268435456
    rotate_seconds: 3600

  jsonl:
    directory: "/var/lib/notaihoney/events"
    rotate_size_bytes: 67108864
    rotate_seconds: 3600

# ---------------------------------------------------------------------------
# RESOURCE LIMITS
# ---------------------------------------------------------------------------

limits:
  max_connections_total: 1024
  max_connections_per_service: 256

  max_requests_per_connection: 1000
  max_connection_lifetime_seconds: 3600
  max_connection_bytes: 67108864

  max_header_bytes: 32768
  max_body_bytes: 4194304
  max_response_bytes: 4194304

  max_structured_event_bytes: 262144
  max_structured_headers: 128
  max_query_fields: 128

  tls_handshake_timeout_seconds: 5
  header_timeout_seconds: 5
  body_timeout_seconds: 15
  write_timeout_seconds: 15
  idle_timeout_seconds: 30

  max_stream_seconds: 60

  max_post_failure_capture_bytes: 4194304
  post_failure_capture_timeout_seconds: 5

# ===========================================================================
# SIMULATED SERVICES
# Milestone 1 personality: Ollama
# Product-specific behavior remains entirely YAML-defined.
# ===========================================================================

services:
  ollama:
    enabled: true

    listener:
      address: "0.0.0.0"
      port: 11434
      protocol: "http"

    identity:
      product: "ollama"
      variant: "default"

    default_headers:
      Content-Type: "application/json"

    routes:
      - method: "GET"
        path: "/"
        classification: "version_discovery"
        responses:
          - sequence: default
            status: 200
            response_mode: "immediate"
            body: |
              Ollama is running


      - method: "GET"
        path: "/api/version"
        classification: "version_discovery"
        responses:
          - sequence: default
            status: 200
            response_mode: "immediate"
            body: |
              {"version":"0.11.4"}

      - method: "GET"
        path: "/api/tags"
        classification: "model_discovery"
        responses:
          - sequence: default
            status: 200
            response_mode: "immediate"
            body: "{\"models\":[{\"name\":\"llama3.2:latest\",\"model\":\"llama3.2:latest\",\"modified_at\":\"2025-05-04T17:37:44.706015396-07:00\",\"size\":2019393189,\"digest\":\"a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72\",\"details\":{\"parent_model\":\"\",\"format\":\"gguf\",\"family\":\"llama\",\"families\":[\"llama\"],\"parameter_size\":\"3.2B\",\"quantization_level\":\"Q4_K_M\"}}]}"

      - method: "GET"
        path: "/api/ps"
        classification: "model_discovery"
        responses:
          - sequence: default
            status: 200
            response_mode: "immediate"
            body: "{\"models\":[]}"

      - method: "POST"
        path: "/api/show"
        classification: "metadata_discovery"
        responses:
          - sequence: default
            status: 200
            response_mode: "immediate"
            body: "{\"parameters\":\"stop \\\"<|start_header_id|>\\\"\\nstop \\\"<|end_header_id|>\\\"\\nstop \\\"<|eot_id|>\\\"\",\"details\":{\"parent_model\":\"\",\"format\":\"gguf\",\"family\":\"llama\",\"families\":[\"llama\"],\"parameter_size\":\"3.2B\",\"quantization_level\":\"Q4_K_M\"},\"model_info\":{\"general.architecture\":\"llama\",\"llama.attention.head_count\":24,\"llama.attention.head_count_kv\":8,\"llama.attention.key_length\":128,\"llama.attention.layer_norm_rms_epsilon\":0.00001,\"llama.attention.value_length\":128,\"llama.block_count\":28,\"llama.context_length\":131072,\"llama.embedding_length\":3072,\"llama.feed_forward_length\":8192,\"llama.rope.dimension_count\":128,\"llama.rope.freq_base\":500000,\"llama.vocab_size\":128256,\"tokenizer.ggml.bos_token_id\":128000,\"tokenizer.ggml.eos_token_id\":128009,\"tokenizer.ggml.model\":\"gpt2\",\"tokenizer.ggml.pre\":\"llama-bpe\"},\"capabilities\":[\"completion\",\"tools\"]}"

      - method: "POST"
        path: "/api/generate"
        classification: "inference_attempt"
        responses:
          - sequence: default
            status: 200
            response_mode: "ndjson"
            headers:
              Content-Type: "application/x-ndjson"
            chunks:
              - delay_ms: 50
                body: "{\"model\":\"llama3.2:latest\",\"created_at\":\"2025-07-07T20:22:19.193140Z\",\"response\":\"Hello\",\"done_reason\":\"stop\",\"done\":true,\"total_duration\":182242375,\"load_duration\":41295167,\"prompt_eval_count\":12,\"prompt_eval_duration\":24573166,\"eval_count\":2,\"eval_duration\":115959084}\n"

      - method: "POST"
        path: "/api/chat"
        classification: "inference_attempt"
        responses:
          - sequence: default
            status: 200
            response_mode: "ndjson"
            headers:
              Content-Type: "application/x-ndjson"
            chunks:
              - delay_ms: 50
                body: "{\"model\":\"llama3.2:latest\",\"created_at\":\"2025-07-07T20:22:19.193140Z\",\"message\":{\"role\":\"assistant\",\"content\":\"Hello\"},\"done_reason\":\"stop\",\"done\":true,\"total_duration\":182242375,\"load_duration\":41295167,\"prompt_eval_count\":12,\"prompt_eval_duration\":24573166,\"eval_count\":2,\"eval_duration\":115959084}\n"

    default_response:
      status: 404
      headers:
        Content-Type: "application/json"
      body: |
        {"error":"404 page not found"}

# ---------------------------------------------------------------------------
# OPTIONAL OFFLINE ANALYSIS
# Used only by: notaihoney index
# The live serve path does not depend on SQLite.
# ---------------------------------------------------------------------------

analysis:
  sqlite:
    path: "/var/lib/notaihoney/index/honeypot.db"
